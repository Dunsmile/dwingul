{
  "name": "dwingul",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/generate-pixel-assets.mjs && node scripts/generate-world-assets.mjs && node scripts/build-illustrated-art.mjs && node scripts/build-artbook.mjs && node scripts/build-site.mjs",
    "dev": "wrangler dev --port 4175",
    "deploy": "npm run build && wrangler deploy",
    "check": "node --check server/api.js && node --check public/js/app.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "lunar-javascript": "1.7.7"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "wrangler": "^4.131.1"
  }
}

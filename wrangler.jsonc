{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"dwingul",
 "main":"workers/index.js",
 "workers_dev":true,
 "routes":[{"pattern":"dwingul.com","custom_domain":true},{"pattern":"www.dwingul.com","custom_domain":true}],
 "account_id":"575e211b834a13c9401d04fc633ea979",
 "compatibility_date":"2026-09-01",
 "compatibility_flags":["nodejs_compat"],
 "assets":{"directory":"dist","binding":"ASSETS","run_worker_first":true},
 "durable_objects":{"bindings":[{"name":"DB","class_name":"DwingulDatabase"}]},
 "migrations":[{"tag":"v1","new_sqlite_classes":["DwingulDatabase"]}],
 "observability":{"enabled":true,"head_sampling_rate":0.1}
}
